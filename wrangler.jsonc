{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "ns-gourmet-gestor-omega",
  "main": "./src/index.mjs",
  "compatibility_date": "2026-11-22",
  "vars": {
    "SUPABASE_URL": "https://kluxlinnqtlitnbwafdj.supabase.co",
    "ADMIN_EMAIL": "ns_gourmet@profissional.com",
    "SUPABASE_PUBLISHABLE_KEY": "sb_publishable_78gp2D405BISAERmTzPv_g_GGdW2UDs"
  },
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "not_found_handling": "none",
    "run_worker_first": [
      "/api/*",
      "/admin*"
    ],
    "html_handling": "none"
  },
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 0.1
    }
  },
  "ratelimits": [
    {
      "name": "PUBLIC_ORDER_LIMITER",
      "namespace_id": "2026112201",
      "simple": {
        "limit": 12,
        "period": 60
      }
    }
  ],
  "previews": {
    "vars": {
      "SUPABASE_URL": "https://preview.invalid",
      "ADMIN_EMAIL": "ns_gourmet@profissional.com",
      "SUPABASE_PUBLISHABLE_KEY": "preview-disabled"
    },
    "ratelimits": [
      {
        "name": "PUBLIC_ORDER_LIMITER",
        "namespace_id": "2026112202",
        "simple": {
          "limit": 12,
          "period": 60
        }
      }
    ]
  }
}
