{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "ns-gourmet-gestor-omega",
  "main": "worker.js",
  "compatibility_date": "2026-11-13",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": [
      "/api/*",
      "/",
      "/pedido",
      "/admin"
    ]
  },
  "observability": {
    "enabled": true
  },
  "vars": {
    "SUPABASE_URL": "https://kluxlinnqtlitnbwafdj.supabase.co"
  }
}
